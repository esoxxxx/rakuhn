<!-- TESTIMONIALS -->
<section class="testi-section">
  <div class="section-label">Stimmen meiner Kund:innen</div>
  <h2 class="section-title">Was <em>Familien</em> sagen</h2>

  <div class="testi-grid">

    {% for testi in collections.testimonials %}
    <div class="testi-card">
        <div class="testi-stars">{{ testi.data.stars }}</div>
        <p class="testi-text">{{ testi.data.text }}</p>
        <div class="testi-author">
          <div class="testi-avatar">{% if testi.data.gender == "male" %}👨{% else %}👩{% endif %}</div>
          <div>
            <div class="testi-name">{{ testi.data.name }}</div>
            <div class="testi-meta">{{ testi.data.meta }}</div>
          </div>
        </div>
      </div>
    {% endfor %}

  </div>
</section>