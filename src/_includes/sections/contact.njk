<!-- KONTAKTFORMULAR -->
<section class="contact-section" id="kontakt-formular">
  <div class="section-label" style="text-align:center;">Ich freue mich auf deine Anfrage</div>
  <h2 class="section-title" style="margin:0 auto 1rem;">Kontakt <em>aufnehmen</em></h2>
  <p class="section-sub" style="margin:0 auto 2.5rem; text-align:center;">Möchtest du etwas bestellen? Schreib mir einfach – ich melde mich so schnell wie möglich bei dir.</p>

  <div class="contact-form">
    <div class="contact-row">
      <div class="contact-field">
        <input type="text" id="cf-name" placeholder="Ihr Name *" required>
      </div>
      <div class="contact-field">
        <input type="email" id="cf-email" placeholder="Ihre E-Mail *" required>
      </div>
    </div>
    <div class="contact-row">
      <div class="contact-field">
        <input type="tel" id="cf-phone" placeholder="Telefonnummer">
      </div>
      <div class="contact-field">
        <input type="text" id="cf-subject" placeholder="Betreff">
      </div>
    </div>
    <div class="contact-field">
      <textarea id="cf-message" placeholder="Ihre Nachricht *" required></textarea>
    </div>
    <div class="contact-submit">
      <button class="btn-primary" id="cf-submit" style="padding: 1rem 2.5rem; font-size: 1rem; letter-spacing: 0.05em; text-transform: uppercase;">Nachricht senden ✦</button>
    </div>
    <p class="contact-success" id="cf-success">✓ Vielen Dank! Ich melde mich bei dir.</p>
  </div>
</section>