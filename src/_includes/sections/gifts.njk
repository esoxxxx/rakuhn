<!-- GIFTS -->
<section class="gifts-section" id="geschenke">
  <div class="section-label">Geburtsgeschenke</div>
  <h2 class="section-title">Die <em>perfekte Freude</em><br>zur Geburt</h2>
  <p class="section-sub">Jedes meiner Geschenksets wird mit Liebe zusammengestellt und schön verpackt – fertig zum Verschenken.</p>
 
  <div class="gifts-grid">

  {% for gift in collections.gifts %}
    <div class="gift-card">
      <img class="gift-img" src="{{ gift.data.icon }}" alt="{{ gift.data.name }}" style="width: 100%; object-fit: cover;">
      <div class="gift-info">
        <div class="gift-name">{{ gift.data.name }}</div>
        <div class="gift-price">{{ gift.data.price }}</div>
        <button class="gift-btn">Produkt anfragen</button>
        <button class="gift-btn gift-btn2">
          <div class="gifts-content">
                <a href="/gifts/{{ gift.fileSlug }}/" class="btn-secondary">Stöbern ✦</a>
          </div>
          Stöbern
        </button>
      </div>
    </div>
  {% endfor %}

  </div>
</section>