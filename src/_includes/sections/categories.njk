<!-- CATEGORIES -->
<section class="section" id="kategorien">
  <div class="section-label">Meine Kollektionen</div>
  <h2 class="section-title">Alles für <em>kleine Entdecker</em></h2>
  <p class="section-sub">Von zarten Stramplern bis zu liebevollen Geschenksets – bei Rakuhn findest du das Richtige für jeden Anlass.</p>

  <div class="cats-grid">

    {% for category in collections.categories %}
    <div class="cat-card">
      <div class="cat-bg">
        <div class="cat-emoji">{{ category.data.emoji }}</div>
        <div class="cat-content">
          <div class="cat-title">{{ category.data.title }}</div>
          <div class="cat-desc">{{ category.data.description }}</div>
          <div class="cat-arrow">&gt;</div>
        </div>
      </div>
    </div>
    {% endfor %}

  </div>
</section>