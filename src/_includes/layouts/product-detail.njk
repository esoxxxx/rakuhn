---
layout: layouts/base.njk
---
<style>
  .product-fab {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 200;
  }
  .product-fab__order {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0,0,0,0.22);
    transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .product-fab__order:hover {
    background: var(--accent-dark);
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(0,0,0,0.28);
  }
  .product-fab__order svg {
    transform: translate(-1px, -1px);
  }
  @media (max-width: 768px) {
    .product-fab {
      right: 1rem;
      bottom: 1.5rem;
      top: auto;
      transform: none;
    }
  }
</style>

<div class="product-fab">
  <button class="product-fab__order"
          data-name="{{ name }}"
          data-price="{{ price }}"
          id="fab-anfragen"
          aria-label="Jetzt anfragen">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
    </svg>
  </button>
</div>

<script>
  document.getElementById('fab-anfragen').addEventListener('click', function () {
    sessionStorage.setItem('anfrage_produkt', this.dataset.name);
    sessionStorage.setItem('anfrage_preis', this.dataset.price);
    window.location.href = '/#kontakt-formular';
  });
</script>

<section class="section">
  <div class="container">
    <h1 class="section-title">{{ name }}</h1>
    
    <div class="gift-description">
      {{ content | safe }}
    </div>

    {# Hier holen wir die Bilder basierend auf dem Dateinamen (fileSlug) #}
    {% set images = products[page.fileSlug] %}
    
    {% if images %}
    <div class="gallery-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 40px;">
      {% for img in images %}
      <div class="gallery-item" style="aspect-ratio: 1/1; overflow: hidden; border-radius: 12px;">
        <img src="/assets/img/products/{{ page.fileSlug }}/{{ img }}" 
             alt="{{ title }}" 
             style="width: 100%; height: 100%; object-fit: cover;"
             loading="lazy">
      </div>
      {% endfor %}
    </div>
    {% else %}
      <p style="text-align: center; margin-top: 20px;">Keine Bilder in /assets/img/products/{{ page.fileSlug }} gefunden.</p>
    {% endif %}

    <p style="text-align: center; margin-top: 50px;">
      <a href="/#kategorien" class="gift-btn">← Zurück zur Übersicht</a>
    </p>
  </div>
</section>